# --- Python & Cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.cache/

# --- Environment & Virtual Environments ---
venv/
.venv/
env/
.env
bin/
lib/
share/
pyvenv.cfg

# --- Version Control ---
.git/
.gitignore
.gitattributes

# --- Database & Local Data ---
# Jangan ikutkan database SQLite lokal agar tidak menimpa data di kontainer
instance/*.db
instance/*.sqlite
.ipynb_checkpoints/

# --- Temporary & Upload Files ---
# Jangan ikutkan file upload lokal agar kontainer bersih saat pertama jalan
static/uploads/kunjungan/*
static/uploads/materi/*
tmp/
temp/
*.log

# --- IDE & OS Trash ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
